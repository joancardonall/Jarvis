# Copy to .dev.vars (ignored). Generate your own credentials with npm run token.
# Never paste real credentials in chat or commit them.
DATABASE_URL="postgresql://runtime:REPLACE_ME@YOUR_NEON_HOST/jarvis?sslmode=require"
DEV_TOKEN_SHA256="REPLACE_WITH_GENERATED_SHA256"
DEV_OWNER_ID="REPLACE_WITH_GENERATED_UUID"
DEV_TOKEN_EXPIRES_AT="REPLACE_WITH_GENERATED_EXPIRY"
# Exact origin, no trailing slash. Empty forbids browser Origin headers.
ALLOWED_ORIGIN=""
# OAuth login with GitHub (D023). Local development only needs these to try the login flow;
# create a separate GitHub OAuth App whose callback is http://127.0.0.1:8787/oauth/callback.
OAUTH_SIGNING_KEY="REPLACE_WITH_43_OR_MORE_RANDOM_BASE64URL_CHARACTERS"
GITHUB_CLIENT_ID="REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_ID"
GITHUB_CLIENT_SECRET="REPLACE_WITH_GITHUB_OAUTH_APP_CLIENT_SECRET"
# Optional daily summary by Telegram (D025). Leave unset to disable sending.
# TELEGRAM_BOT_TOKEN="REPLACE_WITH_TOKEN_FROM_BOTFATHER"
# TELEGRAM_CHAT_ID="REPLACE_WITH_YOUR_NUMERIC_CHAT_ID"
# Hour of the day in Europe/Madrid from which the summary is sent (default 7).
# SUMMARY_HOUR="7"
