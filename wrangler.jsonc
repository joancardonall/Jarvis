{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "account_id": "dfcbc5c30e5e078c2593b26253916e4e",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Public numeric id of the only GitHub account allowed to log in (not a secret).
  // The username is deliberately not used: it can be renamed and reused by someone else.
  "vars": { "GITHUB_ALLOWED_USER_ID": "209090554" },
  // Morning summary for Telegram (D025). Cron times are UTC and UTC has no daylight saving, so the
  // Worker is woken at 05:30, 06:30, 07:30 and 08:30 UTC and decides itself whether it is already
  // 07:00 in Madrid and whether today's summary was sent. Without Telegram secrets it does nothing.
  "triggers": { "crons": ["30 5-8 * * *"] }
}
