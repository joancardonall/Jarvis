{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarvis",
  "account_id": "dfcbc5c30e5e078c2593b26253916e4e",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  // Public numeric id of the only GitHub account allowed to log in (not a secret).
  // The username is deliberately not used: it can be renamed and reused by someone else.
  "vars": { "GITHUB_ALLOWED_USER_ID": "209090554" }
}
